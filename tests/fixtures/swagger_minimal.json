{
  "swagger": "2.0",
  "info": {
    "title": "Order Service",
    "version": "v1.0.0",
    "x-project-code": "ORD"
  },
  "host": "api.example.com",
  "security": [{"bearerAuth": []}],
  "securityDefinitions": {
    "bearerAuth": {"type": "apiKey", "name": "Authorization", "in": "header"}
  },
  "paths": {
    "/api/orders": {
      "post": {
        "summary": "Tạo đơn hàng",
        "description": "Tạo đơn hàng mới cho người dùng đang đăng nhập",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["productId", "quantity"],
              "properties": {
                "productId": {"type": "string", "minLength": 3, "maxLength": 20},
                "quantity": {"type": "integer", "minimum": 1, "maximum": 100},
                "voucher": {"type": "string", "enum": ["SAVE10", "SAVE20"]}
              }
            }
          }
        ],
        "responses": {
          "201": {"description": "Tạo thành công"},
          "400": {"description": "Dữ liệu không hợp lệ", "x-error-code": "VALIDATION_ERROR"},
          "401": {"description": "Thiếu token"}
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Lấy đơn hàng theo id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "minimum": 1
          }
        ],
        "responses": {
          "200": {"description": "Trả về đơn hàng"},
          "404": {"description": "Không tìm thấy"}
        }
      }
    }
  }
}
